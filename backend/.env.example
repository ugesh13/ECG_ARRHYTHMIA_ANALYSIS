# Copy to .env and adjust. Never commit .env.
APP_NAME=ECG Arrhythmia Analysis API
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths are resolved against the backend/ directory
MITBIH_DIR=data/mitbih
UPLOADS_DIR=data/uploads
MODELS_DIR=models
HISTORY_FILE=data/history.json
# Per-file upload limit (MB)
MAX_UPLOAD_MB=50
# Default cap on points returned by /signal (server-side decimation)
MAX_SIGNAL_POINTS=5000
